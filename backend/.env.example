# Copy to backend/.env for local runs. Never commit the real file (.env is gitignored).
# Render: set these in the service's Environment tab (render.yaml declares them as sync: false).

# Neon Postgres connection string, e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Secret used to sign bearer tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Allowed browser origins, comma separated, e.g. https://pawnup.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
