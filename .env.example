# Frontend environment variables. Copy to .env.local for local runs.
# Vercel: set these in Project Settings > Environment Variables (they are inlined at build time).

# Base URL of the backend API / WebSocket host (Render service URL in production).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL of the frontend itself; used for absolute og:image / og:url tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
